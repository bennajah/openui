            "target": "{ui}/textarea.vue",
            "type": "component"
          }
        ]
      }
    },
    {
      "name": "select",
      "title": "Select",
      "description": "A native select element with consistent field styling and a decorative chevron.",
      "meta": {
        "props": [
          {
            "name": "invalid",
            "type": "boolean",
            "default": "false",
            "description": "Marks the control as invalid and adds a red border."
          }
        ]
      },
      "sources": {
        "react": [
          {
            "path": "packages/react/src/select.tsx",
