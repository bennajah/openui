          }
        ],
        "vue": [
          {
            "path": "packages/vue/src/select.vue",
            "target": "{ui}/select.vue",
            "type": "component"
          }
        ]
      }
    },
    {
      "name": "checkbox",
      "title": "Checkbox",
      "description": "A native checkbox input styled with Tailwind accents.",
