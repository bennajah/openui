            "type": "component"
          }
        ]
      }
    },
    {
      "name": "theme",
      "title": "Theme",
      "description": "Light, dark, and system theme state with a no-flash init script and a cycling toggle button.",
      "meta": {
        "props": [
          {
            "name": "initialTheme",
            "type": "'light' | 'dark' | 'system'",
            "default": "'system'",
            "description": "Theme used before the stored value is read. Only needed outside a browser."
          }
        ]
      },
      "sources": {
        "react": [
          {
            "path": "packages/react/src/theme-toggle.tsx",
            "target": "{ui}/theme-toggle.tsx",
            "type": "component",
            "languageVariants": true
          },
          {
            "path": "packages/react/src/theme.ts",
            "target": "{ui}/theme.ts",
            "type": "lib",
            "languageVariants": true
          }
        ],
        "svelte": [
          {
            "path": "packages/svelte/src/theme-toggle.svelte",
            "target": "{ui}/theme-toggle.svelte",
