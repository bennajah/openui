            "type": "component"
          }
        ]
      }
    },
    {
      "name": "label",
      "title": "Label",
      "description": "A native label with form typography and peer-disabled styling.",
      "sources": {
        "react": [
          {
            "path": "packages/react/src/label.tsx",
            "target": "{ui}/label.tsx",
            "type": "component",
            "languageVariants": true
          }
        ],
        "svelte": [
          {
            "path": "packages/svelte/src/label.svelte",
