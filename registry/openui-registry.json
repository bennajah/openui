            "type": "component"
          }
        ]
      }
    },
    {
      "name": "field",
      "title": "Field",
      "description": "Composes a label, control, and hint or error message with for/id and aria-describedby wiring.",
      "meta": {
        "props": [
          {
            "name": "label",
            "type": "string | ReactNode",
            "default": "\"\"",
            "description": "Visible label text."
          },
          {
            "name": "hint",
            "type": "string | ReactNode",
            "default": "\"\"",
            "description": "Helper text linked with aria-describedby."
          },
          {
            "name": "error",
            "type": "string | ReactNode",
            "default": "\"\"",
            "description": "Error message that also sets aria-invalid on the control."
          },
          {
            "name": "id",
            "type": "string",
            "default": "generated",
            "description": "Control id. Generated when omitted."
          }
        ]
      },
      "sources": {
        "react": [
          {
            "path": "packages/react/src/field.tsx",
            "target": "{ui}/field.tsx",
            "type": "component",
            "languageVariants": true
          }
        ],
        "svelte": [
          {
            "path": "packages/svelte/src/field.svelte",
