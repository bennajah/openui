          }
        ]
      }
    },
    {
      "name": "radio",
      "title": "Radio",
      "description": "A native radio input. Group inputs by sharing a name and pair them with Label.",
      "meta": {
        "props": [
          {
            "name": "invalid",
            "type": "boolean",
            "default": "false",
            "description": "Adds an error outline and sets aria-invalid."
          }
        ]
      },
      "sources": {
        "react": [
          {
            "path": "packages/react/src/radio.tsx",
