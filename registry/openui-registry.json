          }
        ],
        "astro": [
          {
            "path": "packages/astro/src/theme-toggle.astro",
            "target": "{ui}/theme-toggle.astro",
            "type": "component"
          },
          {
            "path": "packages/astro/src/theme.ts",
            "target": "{ui}/theme.ts",
            "type": "lib",
            "languageVariants": true
