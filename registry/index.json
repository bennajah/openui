{
  "$schema": "https://openui.dev/registry/schema.json",
  "name": "openui",
  "version": "0.1.0-beta.0",
  "homepage": "https://openui.dev",
  "components": {
    "button": {
      "title": "Button",
      "description": "A framework-native button with disjoint variants and sizes, built on Tailwind CSS utilities.",
      "frameworks": {
        "react": {
          "item": "r/button-react.json"
        },
        "svelte": {
          "item": "r/button-svelte.json"
        },
        "astro": {
          "item": "r/button-astro.json"
        },
        "vue": {
          "item": "r/button-vue.json"
        }
      },
      "meta": {
        "variant": [
          {
            "name": "primary",
            "description": "High-emphasis action. The default."
          },
          {
            "name": "secondary",
            "description": "Lower-emphasis action on a subtle surface."
          },
          {
            "name": "outline",
            "description": "Bordered action for secondary contexts."
          },
          {
            "name": "ghost",
            "description": "Borderless action, usually in toolbars."
          },
          {
            "name": "danger",
            "description": "Destructive or irreversible action."
          },
          {
            "name": "link",
            "description": "Inline text action that looks like a link."
          }
        ],
        "size": [
          {
            "name": "sm",
            "description": "Compact 32px control."
          },
          {
            "name": "md",
            "description": "Default 40px control."
          },
          {
            "name": "lg",
            "description": "Prominent 48px control."
          },
          {
            "name": "icon",
            "description": "Square 40px control for a single icon."
          }
        ],
        "props": [
          {
            "name": "variant",
            "type": "'primary' | 'secondary' | 'outline' | 'ghost' | 'danger' | 'link'",
            "default": "'primary'",
            "description": "Visual emphasis of the button."
          },
          {
            "name": "size",
            "type": "'sm' | 'md' | 'lg' | 'icon'",
            "default": "'md'",
            "description": "Control height and horizontal padding."
          },
          {
            "name": "fullWidth",
            "type": "boolean",
            "default": "false",
            "description": "Stretch the button to the width of its container."
          },
          {
            "name": "type",
            "type": "'button' | 'submit' | 'reset'",
            "default": "'button'",
            "description": "Native button type. Defaults to button so forms do not submit accidentally."
          }
        ]
      }
    },
    "input": {
      "title": "Input",
      "description": "A native text input with shared field styling and an invalid state.",
      "frameworks": {
        "react": {
          "item": "r/input-react.json"
        },
        "svelte": {
          "item": "r/input-svelte.json"
        },
        "astro": {
          "item": "r/input-astro.json"
        },
        "vue": {
          "item": "r/input-vue.json"
        }
      },
      "meta": {
        "props": [
          {
            "name": "invalid",
            "type": "boolean",
            "default": "false",
            "description": "Marks the control as invalid and adds a red border."
          }
        ]
      }
    },
    "textarea": {
      "title": "Textarea",
      "description": "A native multi-line input that shares the Input field treatment.",
      "frameworks": {
        "react": {
          "item": "r/textarea-react.json"
        },
        "svelte": {
          "item": "r/textarea-svelte.json"
        },
        "astro": {
          "item": "r/textarea-astro.json"
        },
        "vue": {
          "item": "r/textarea-vue.json"
        }
      },
      "meta": {
        "props": [
          {
            "name": "invalid",
            "type": "boolean",
            "default": "false",
            "description": "Marks the control as invalid and adds a red border."
          },
          {
            "name": "rows",
            "type": "number",
            "default": "4",
            "description": "Initial visible line count."
          }
        ]
      }
    },
    "select": {
      "title": "Select",
      "description": "A native select element with consistent field styling and a decorative chevron.",
      "frameworks": {
        "react": {
          "item": "r/select-react.json"
        },
        "svelte": {
          "item": "r/select-svelte.json"
        },
        "astro": {
          "item": "r/select-astro.json"
        },
        "vue": {
          "item": "r/select-vue.json"
        }
      },
      "meta": {
        "props": [
          {
            "name": "invalid",
            "type": "boolean",
            "default": "false",
            "description": "Marks the control as invalid and adds a red border."
          }
        ]
      }
    },
    "checkbox": {
      "title": "Checkbox",
      "description": "A native checkbox input styled with Tailwind accents.",
      "frameworks": {
        "react": {
          "item": "r/checkbox-react.json"
        },
        "svelte": {
          "item": "r/checkbox-svelte.json"
        },
        "astro": {
          "item": "r/checkbox-astro.json"
        },
        "vue": {
          "item": "r/checkbox-vue.json"
        }
      },
      "meta": {
        "props": [
          {
            "name": "invalid",
            "type": "boolean",
            "default": "false",
            "description": "Adds an error outline and sets aria-invalid."
          }
        ]
      }
    },
    "radio": {
      "title": "Radio",
      "description": "A native radio input. Group inputs by sharing a name and pair them with Label.",
      "frameworks": {
        "react": {
          "item": "r/radio-react.json"
        },
        "svelte": {
          "item": "r/radio-svelte.json"
        },
        "astro": {
          "item": "r/radio-astro.json"
        },
        "vue": {
          "item": "r/radio-vue.json"
        }
      },
      "meta": {
        "props": [
          {
            "name": "invalid",
            "type": "boolean",
            "default": "false",
            "description": "Adds an error outline and sets aria-invalid."
          }
        ]
      }
    },
    "label": {
      "title": "Label",
      "description": "A native label with form typography and peer-disabled styling.",
      "frameworks": {
        "react": {
          "item": "r/label-react.json"
        },
        "svelte": {
          "item": "r/label-svelte.json"
        },
        "astro": {
          "item": "r/label-astro.json"
        },
        "vue": {
          "item": "r/label-vue.json"
        }
      }
    },
    "field": {
      "title": "Field",
      "description": "Composes a label, control, and hint or error message with for/id and aria-describedby wiring.",
      "frameworks": {
        "react": {
          "item": "r/field-react.json"
        },
        "svelte": {
          "item": "r/field-svelte.json"
        },
        "astro": {
          "item": "r/field-astro.json"
        },
        "vue": {
          "item": "r/field-vue.json"
        }
      },
      "meta": {
        "props": [
          {
            "name": "label",
            "type": "string | ReactNode",
            "default": "\"\"",
            "description": "Visible label text."
          },
          {
            "name": "hint",
            "type": "string | ReactNode",
            "default": "\"\"",
            "description": "Helper text linked with aria-describedby."
          },
          {
            "name": "error",
            "type": "string | ReactNode",
            "default": "\"\"",
            "description": "Error message that also sets aria-invalid on the control."
          },
          {
            "name": "id",
            "type": "string",
            "default": "generated",
            "description": "Control id. Generated when omitted."
          }
        ]
      }
    }
  }
}
