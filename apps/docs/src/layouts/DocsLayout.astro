---
import { getCollection } from "astro:content";
import "../styles/global.css";
import ThemeToggle from "@openui/astro/theme-toggle.astro";
import { THEME_INIT_SCRIPT } from "@openui/astro/theme";

interface HeadingLink {
  depth: number;
  text: string;
  slug: string;
}

interface Breadcrumb {
  label: string;
  href: string;
}

interface Props {
  title?: string;
  description?: string;
  currentSlug?: string;
  headings?: HeadingLink[];
  breadcrumb?: Breadcrumb;
  editPath?: string;
}

const { title, description, currentSlug, headings = [], breadcrumb, editPath } = Astro.props;

const entries = await getCollection("docs");

const rank = (id: string): number => {
  if (id.startsWith("frameworks/")) return 2;
  if (id.startsWith("components/")) return 1;
  return 0;
};

const sorted = entries.toSorted((a, b) => {
  if (rank(a.id) !== rank(b.id)) return rank(a.id) - rank(b.id);
  if (a.data.order !== b.data.order) return a.data.order - b.data.order;
  return a.id.localeCompare(b.id);
});

const reference = sorted.filter((entry) => rank(entry.id) === 0);
const components = sorted.filter((entry) => rank(entry.id) === 1);
const frameworks = sorted.filter((entry) => rank(entry.id) === 2);

const groups = [
  { label: "Getting started", entries: reference },
  { label: "Components", entries: components },
  { label: "Frameworks", entries: frameworks },
].filter((group) => group.entries.length > 0);

const href = (id: string): string => `/docs/${id.replace(/\/index$/, "")}`;
const isActive = (id: string): boolean =>
  currentSlug !== undefined &&
  (currentSlug === id || (id.endsWith("/index") && currentSlug === id.replace(/\/index$/, "")));

const pageTitle = title === undefined ? "OpenUI" : `${title} · OpenUI`;
const pageDescription = description ?? "Framework-native UI components installed as source.";
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    <!-- Applies the stored theme before first paint so there is no flash. -->
    <script is:inline set:html={THEME_INIT_SCRIPT}></script>
  </head>
  <body class="min-h-screen">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-zinc-900 focus:px-3 focus:py-2 focus:text-sm focus:text-white dark:focus:bg-white dark:focus:text-zinc-900"
      >Skip to content</a
    >
    <header
      class="sticky top-0 z-40 border-b border-zinc-200 bg-white/90 backdrop-blur dark:border-zinc-800 dark:bg-zinc-950/90"
    >
      <div class="mx-auto flex h-14 max-w-7xl items-center gap-6 px-4 sm:px-6">
        <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
          <span
            class="grid size-6 place-items-center rounded-md bg-zinc-900 text-[11px] font-bold text-white dark:bg-white dark:text-zinc-900"
            >O</span
          >
          OpenUI
        </a>
        <nav class="flex items-center gap-4 text-sm text-zinc-600 dark:text-zinc-400">
          <a class="hover:text-zinc-950 dark:hover:text-white" href="/docs">Docs</a>
          <a class="hover:text-zinc-950 dark:hover:text-white" href="/docs/components">Components</a>
          <a class="hover:text-zinc-950 dark:hover:text-white" href="/llms.txt">llms.txt</a>
        </nav>
        <a
          class="ml-auto text-sm text-zinc-600 hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-white"
          href="https://github.com/bennajah/openui"
          rel="noreferrer">GitHub</a
        >
        <ThemeToggle />
      </div>
    </header>

    <div class="mx-auto flex max-w-7xl gap-10 px-4 py-10 sm:px-6">
      <aside class="hidden w-56 shrink-0 lg:block">
        <nav aria-label="Documentation" class="sticky top-24 space-y-6 text-sm">
          {
            groups.map((group) => (
              <div>
                <p class="mb-2 text-xs font-semibold tracking-wider text-zinc-500 uppercase">
                  {group.label}
                </p>
                <ul class="space-y-0.5">
                  {group.entries.map((entry) => (
                    <li>
                      <a
                        href={href(entry.id)}
                        aria-current={isActive(entry.id) ? "page" : undefined}
                        class:list={[
                          "block rounded-md px-2 py-1.5 transition-colors",
                          isActive(entry.id)
                            ? "bg-zinc-100 font-medium text-zinc-950 dark:bg-zinc-800 dark:text-white"
                            : "text-zinc-600 hover:bg-zinc-50 hover:text-zinc-950 dark:text-zinc-400 dark:hover:bg-zinc-900 dark:hover:text-white",
                        ]}
                      >
                        {entry.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
          <div class="border-t border-zinc-200 pt-4 dark:border-zinc-800">
            <a
              class="text-zinc-500 hover:text-zinc-950 dark:text-zinc-500 dark:hover:text-white"
              href="/llms-full.txt">Full docs for LLMs</a
            >
          </div>
        </nav>
      </aside>

      <main id="content" class="min-w-0 flex-1">
        {
          breadcrumb !== undefined && (
            <nav aria-label="Breadcrumb" class="mb-4 text-sm">
              <a
                class="text-zinc-500 hover:text-zinc-950 dark:text-zinc-500 dark:hover:text-white"
                href={breadcrumb.href}
              >
                {breadcrumb.label}
              </a>
              <span class="px-2 text-zinc-400">/</span>
              <span class="text-zinc-950 dark:text-white">{title}</span>
            </nav>
          )
        }
        <slot />
      </main>

      {
        toc.length > 1 && (
          <aside class="hidden w-48 shrink-0 xl:block">
            <nav aria-label="On this page" class="sticky top-24 text-sm">
              <p class="mb-2 text-xs font-semibold tracking-wider text-zinc-500 uppercase">
                On this page
              </p>
              <ul class="space-y-1 border-l border-zinc-200 dark:border-zinc-800">
                {toc.map((heading) => (
                  <li>
                    <a
                      href={`#${heading.slug}`}
                      class:list={[
                        "-ml-px block border-l border-transparent py-1 leading-5 text-zinc-500 transition-colors hover:border-zinc-400 hover:text-zinc-950 dark:text-zinc-500 dark:hover:border-zinc-500 dark:hover:text-white",
                        heading.depth === 3 ? "pl-6" : "pl-3",
                      ]}
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )
      }
    </div>

    <footer class="border-t border-zinc-200 py-8 dark:border-zinc-800">
      <div
        class="mx-auto flex max-w-7xl flex-col gap-2 px-4 text-sm text-zinc-500 sm:flex-row sm:px-6"
      >
        <p>OpenUI · MIT licensed · beta</p>
        {
          editPath !== undefined && (
            <a
              class="hover:text-zinc-950 dark:hover:text-white"
              href={`https://github.com/bennajah/openui/edit/main/${editPath}`}
              rel="noreferrer"
            >
              Edit this page
            </a>
          )
        }
        <p class="sm:ml-auto">
          <a class="hover:text-zinc-950 dark:hover:text-white" href="/llms.txt">llms.txt</a>
          <span class="px-2">·</span>
          <a class="hover:text-zinc-950 dark:hover:text-white" href="/schema.json">schema.json</a>
          <span class="px-2">·</span>
          <a class="hover:text-zinc-950 dark:hover:text-white" href="/registry/index.json"
            >registry</a
          >
        </p>
      </div>
    </footer>
  </body>
</html>
