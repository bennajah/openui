---
import Input from "@openui/astro/input.astro";
---

<div class="grid w-full max-w-sm gap-3">
  <Input type="email" name="email" placeholder="you@example.com" aria-label="Email" />
  <Input name="invalid" invalid placeholder="Invalid value" aria-label="Invalid input" />
  <Input name="disabled" disabled placeholder="Disabled" aria-label="Disabled input" />
</div>
