---
import { getCollection } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";

const entries = await getCollection("docs");
const sorted = entries.toSorted((a, b) => {
  const aFramework = a.id.startsWith("frameworks/");
  const bFramework = b.id.startsWith("frameworks/");
  if (aFramework !== bFramework) return aFramework ? 1 : -1;
  if (a.data.order !== b.data.order) return a.data.order - b.data.order;
  return a.id.localeCompare(b.id);
});
---

<DocsLayout
  title="Documentation"
  description="Guides for installing OpenUI and building with framework-native components."
>
  <h1 class="text-3xl font-semibold tracking-tight text-zinc-950 dark:text-white">Documentation</h1>
  <p class="mt-3 max-w-2xl text-zinc-600 dark:text-zinc-400">
    Everything you need to initialize a project, install components, and work on the OpenUI
    repository.
  </p>

  <ul class="mt-8 grid gap-4 sm:grid-cols-2">
    {
      sorted.map((entry) => (
        <li>
          <a
            class="block h-full rounded-xl border border-zinc-200 p-5 transition-colors hover:border-zinc-400 dark:border-zinc-800 dark:hover:border-zinc-600"
            href={`/docs/${entry.id}`}
          >
            <h2 class="font-semibold text-zinc-950 dark:text-white">{entry.data.title}</h2>
            <p class="mt-1 text-sm leading-6 text-zinc-600 dark:text-zinc-400">
              {entry.data.description}
            </p>
          </a>
        </li>
      ))
    }
  </ul>
</DocsLayout>
