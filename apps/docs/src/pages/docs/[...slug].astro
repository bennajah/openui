---
import { getCollection, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("docs");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<DocsLayout title={entry.data.title} description={entry.data.description} currentSlug={entry.id}>
  <article class="prose">
    <Content />
  </article>

  <div class="mt-12 flex flex-wrap gap-4 border-t border-zinc-200 pt-6 text-sm dark:border-zinc-800">
    <a class="text-zinc-600 hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-white" href="/docs">
      ← All documentation
    </a>
    <a
      class="ml-auto text-zinc-600 hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-white"
      href={`https://openui.dev/llms/${entry.id}.md`}>Markdown for LLMs</a
    >
  </div>
</DocsLayout>
