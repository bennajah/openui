---
import { getCollection, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import Demo from "../../components/Demo.astro";
import FrameworkTabs from "../../components/FrameworkTabs.astro";
import { extractHeadings } from "../../lib/headings.ts";

export async function getStaticPaths() {
  const entries = await getCollection("docs");
  return entries.map((entry) => ({
    // `components/button.md` → `/docs/components/button`; `components/index.md`
    // → `/docs/components`.
    params: { slug: entry.id.replace(/\/index$/, "") },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings: rendered } = await render(entry);

// Prefer the renderer's own heading list; it matches the ids in the output.
const headings =
  rendered.length > 0
    ? rendered
        .filter((heading) => heading.depth >= 2 && heading.depth <= 3)
        .map((heading) => ({
          depth: heading.depth,
          text: heading.text,
          slug: heading.slug,
        }))
    : extractHeadings(entry.body ?? "");

// Adjacent pages, following the sidebar order.
const all = await getCollection("docs");
const ordered = all.toSorted((a, b) => {
  const rank = (id: string): number => (id.startsWith("frameworks/") ? 2 : 1);
  if (rank(a.id) !== rank(b.id)) return rank(a.id) - rank(b.id);
  if (a.data.order !== b.data.order) return a.data.order - b.data.order;
  return a.id.localeCompare(b.id);
});
const position = ordered.findIndex((page) => page.id === entry.id);
const previous = position > 0 ? ordered[position - 1] : undefined;
const next = position >= 0 && position < ordered.length - 1 ? ordered[position + 1] : undefined;
const href = (id: string): string => `/docs/${id.replace(/\/index$/, "")}`;
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  currentSlug={entry.id}
  headings={headings}
  breadcrumb={entry.id.startsWith("components/")
    ? { label: "Components", href: "/docs/components" }
    : undefined}
  editPath={entry.filePath}
>
  <article class="prose">
    <p class="not-prose mb-2 text-xs font-semibold tracking-wider text-zinc-500 uppercase">
      {entry.data.group === "components" ? "Components" : "Documentation"}
    </p>
    <h1>{entry.data.title}</h1>
    <p class="not-prose mt-2 mb-6 max-w-2xl text-lg leading-8 text-zinc-600 dark:text-zinc-400">
      {entry.data.description}
    </p>

    {entry.data.demo !== undefined && <Demo name={entry.data.demo} />}
    <Content />
  </article>

  {
    entry.data.component !== undefined && (
      <section class="mt-12 border-t border-zinc-200 pt-8 dark:border-zinc-800">
        <h2 class="text-xl font-semibold tracking-tight text-zinc-950 dark:text-white">
          Source
        </h2>
        <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">
          The exact files <code class="rounded bg-zinc-100 px-1.5 py-0.5 font-mono text-[0.85em] dark:bg-zinc-800"
            >openui add {entry.data.component}</code
          > writes into your project. Zero runtime dependencies — edit them freely.
        </p>
        <FrameworkTabs component={entry.data.component} />
      </section>
    )
  }

  <nav
    aria-label="Pagination"
    class="mt-12 flex flex-col gap-3 border-t border-zinc-200 pt-6 text-sm sm:flex-row dark:border-zinc-800"
  >
    {
      previous !== undefined ? (
        <a
          class="group rounded-lg border border-zinc-200 px-4 py-3 transition-colors hover:border-zinc-400 sm:w-1/2 dark:border-zinc-800 dark:hover:border-zinc-600"
          href={href(previous.id)}
        >
          <span class="block text-xs text-zinc-500">Previous</span>
          <span class="font-medium text-zinc-950 dark:text-white">← {previous.data.title}</span>
        </a>
      ) : (
        <span class="hidden sm:block sm:w-1/2" />
      )
    }
    {
      next !== undefined ? (
        <a
          class="group rounded-lg border border-zinc-200 px-4 py-3 text-right transition-colors hover:border-zinc-400 sm:ml-auto sm:w-1/2 dark:border-zinc-800 dark:hover:border-zinc-600"
          href={href(next.id)}
        >
          <span class="block text-xs text-zinc-500">Next</span>
          <span class="font-medium text-zinc-950 dark:text-white">{next.data.title} →</span>
        </a>
      ) : (
        <span class="hidden sm:block sm:w-1/2" />
      )
    }
  </nav>
</DocsLayout>
