{
  "name": "openui-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd apps/docs dev",
    "build": "bun run typecheck && bun run schema:generate && bun run registry:build && bun run llms:generate && bun run build:docs",
    "build:docs": "bun run --cwd apps/docs build",
    "test": "bun test",
    "typecheck": "bun run --filter \"@openui/*\" typecheck",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix",
    "registry:build": "bun run packages/cli/bin/openui.js build",
    "registry:validate": "bun run packages/cli/bin/openui.js validate",
    "llms:generate": "bun run scripts/generate-llms.ts",
    "llms:validate": "bun run scripts/validate-llms.ts",
    "schema:generate": "bun run scripts/generate-schema.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "verify": "bun run scripts/verify.ts",
    "registry:public": "bun run scripts/sync-registry-public.ts"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "^0.5.2",
    "@changesets/cli": "^3.0.3",
    "@types/bun": "^1.4.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "svelte": "^5.57.2",
    "typescript": "^5.9.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "packageManager": "bun@1.4.3"
}
