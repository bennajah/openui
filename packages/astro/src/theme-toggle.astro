---
/**
 * OpenUI ThemeToggle — framework-native, zero runtime dependencies.
 *
 * Plain JavaScript frontmatter (no `lang="ts"`) so the same source installs
 * into TypeScript and JavaScript Astro projects.
 *
 * A native button that cycles `light → dark → system`, persists the choice, and
 * keeps the `dark` class on `<html>` in sync. Each instance carries its own
 * scoped client script, so no islands directive is required.
 *
 * @typedef {"light" | "dark" | "system"} Theme
 */

const { class: className = "", title = "", initialTheme = "system", ...rest } = Astro.props;

const BASE_CLASSES =
  "inline-flex size-9 items-center justify-center rounded-md text-zinc-600 transition-colors hover:bg-zinc-100 hover:text-zinc-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-zinc-400 focus-visible:ring-offset-2 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-white dark:focus-visible:ring-zinc-600 dark:focus-visible:ring-offset-zinc-950";

const classes = [BASE_CLASSES, className].filter(Boolean).join(" ");

const labels = { light: "Light theme", dark: "Dark theme", system: "System theme" };
const resolved = initialTheme in labels ? initialTheme : "system";
const label = `Theme: ${labels[resolved]}. Click to switch.`;
---

<button
  type="button"
  data-openui-theme-toggle
  data-initial-theme={resolved}
  aria-label={label}
  title={title || label}
  class={classes}
  {...rest}
>
  <svg
    data-icon="light"
    hidden={resolved !== "light"}
    class="size-4"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
    ></path>
  </svg>
  <svg
    data-icon="dark"
    hidden={resolved !== "dark"}
    class="size-4"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
  <svg
    data-icon="system"
    hidden={resolved !== "system"}
    class="size-4"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <rect x="3" y="4" width="18" height="12" rx="2"></rect>
    <path d="M8 20h8m-4-4v4"></path>
  </svg>
</button>

<script>
  const LABEL = { light: "Light theme", dark: "Dark theme", system: "System theme" };
  const NEXT = { light: "dark", dark: "system", system: "light" };

  function read() {
    try {
      const value = localStorage.getItem("openui-theme");
      return value === "light" || value === "dark" || value === "system" ? value : "system";
    } catch {
      return "system";
    }
  }

  function apply(theme) {
    const dark =
      theme === "dark" ||
      (theme === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
    document.documentElement.classList.toggle("dark", dark);
    try {
      localStorage.setItem("openui-theme", theme);
    } catch {
      /* storage unavailable */
    }
  }

  function render(button, theme) {
    button.dataset.theme = theme;
    const label = `Theme: ${LABEL[theme]}. Click to switch.`;
    button.setAttribute("aria-label", label);
    button.setAttribute("title", label);
    for (const icon of button.querySelectorAll("[data-icon]")) {
      icon.toggleAttribute("hidden", icon.dataset.icon !== theme);
    }
  }

  function setup() {
    for (const button of document.querySelectorAll("[data-openui-theme-toggle]")) {
      if (button.dataset.bound === "true") continue;
      button.dataset.bound = "true";
      let theme = read();
      apply(theme);
      render(button, theme);
      button.addEventListener("click", () => {
        theme = NEXT[theme];
        apply(theme);
        render(button, theme);
      });
    }
  }

  setup();
  document.addEventListener("astro:after-swap", setup);
</script>
