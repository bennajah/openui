{
  "name": "@openui/astro",
  "version": "0.1.0-beta.0",
  "description": "OpenUI Astro components. Framework-native, zero runtime dependencies, Tailwind CSS v4 theming.",
  "keywords": [
    "astro",
    "components",
    "openui",
    "tailwind",
    "ui"
  ],
  "homepage": "https://openuii.vercel.app",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bennajah/openui.git",
    "directory": "packages/astro"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./theme": "./src/theme.ts",
    "./theme-toggle.astro": "./src/theme-toggle.astro",
    "./button.astro": "./src/button.astro",
    "./checkbox.astro": "./src/checkbox.astro",
    "./field.astro": "./src/field.astro",
    "./input.astro": "./src/input.astro",
    "./label.astro": "./src/label.astro",
    "./radio.astro": "./src/radio.astro",
    "./select.astro": "./src/select.astro",
    "./textarea.astro": "./src/textarea.astro"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "^0.5.2",
    "astro": "^7.4.1"
  },
  "peerDependencies": {
    "astro": ">=5"
  }
}
