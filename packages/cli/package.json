{
  "name": "@openui/cli",
  "version": "0.1.0-beta.0",
  "description": "OpenUI CLI: initialize projects, install framework-native components from a registry, build and validate registries.",
  "keywords": [
    "cli",
    "codegen",
    "components",
    "openui",
    "registry"
  ],
  "homepage": "https://openui.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bennajah/openui.git",
    "directory": "packages/cli"
  },
  "bin": {
    "openui": "./bin/openui.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@openui/core": "workspace:*",
    "typescript": "^5.9.0"
  }
}
