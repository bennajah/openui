{
  "name": "@openui/react",
  "version": "0.1.0-beta.0",
  "description": "OpenUI React components. Framework-native, zero runtime dependencies, Tailwind CSS v4 theming.",
  "keywords": [
    "components",
    "openui",
    "react",
    "tailwind",
    "ui"
  ],
  "homepage": "https://openui.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bennajah/openui.git",
    "directory": "packages/react"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./theme": "./src/theme.ts",
    "./theme-toggle": "./src/theme-toggle.tsx"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
