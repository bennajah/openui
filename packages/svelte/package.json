{
  "name": "@openui/svelte",
  "version": "0.1.0-beta.0",
  "description": "OpenUI Svelte components. Framework-native, zero runtime dependencies, Tailwind CSS v4 theming.",
  "keywords": [
    "components",
    "openui",
    "svelte",
    "tailwind",
    "ui"
  ],
  "homepage": "https://openuii.vercel.app",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bennajah/openui.git",
    "directory": "packages/svelte"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./theme": "./src/theme.ts",
    "./theme-toggle.svelte": "./src/theme-toggle.svelte"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "svelte": ">=5"
