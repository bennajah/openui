{
  "printWidth": 100,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "tabWidth": 2,
  "useTabs": false,
  "sortImports": true,
  "sortTailwindcss": true,
  "astro": true,
  "svelte": true,
  "ignorePatterns": [
    "dist",
    "**/dist/**",
    "node_modules",
