{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "node": true,
    "browser": true,
    "es2022": true
  },
  "ignorePatterns": [
    "dist",
    "**/dist/**",
    "node_modules",
    ".vercel",
    ".astro",
    "registry/r",
    "apps/docs/src/env.d.ts"
  ],
  "overrides": [
    {
      "files": ["packages/cli/**"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["scripts/**", "registry/build/**"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "eslint/no-unused-vars": ["error", { "varsIgnorePattern": "^_", "argsIgnorePattern": "^_" }]
      }
    }
  ]
}
